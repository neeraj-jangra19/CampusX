# Copy this file to .env and edit the values.
# A random SECRET_KEY is generated automatically on first run if you leave this empty.
SECRET_KEY=
PORT=5000
FLASK_DEBUG=false

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Extra origins allowed to call the API (only needed if you serve the frontend
# from a different port, e.g. python -m http.server 5500). Comma separated.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Administrator account (created / updated at every start).
ADMIN_NAME=CampusX Administrator
ADMIN_EMAIL=admin@campusx.local
ADMIN_PASSWORD=ChangeMe123!

# Optional: where reset links point (defaults to the address you opened the site on).
PUBLIC_URL=

# Optional SMTP settings. If empty, password-reset links are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
